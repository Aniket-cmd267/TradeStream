# Server port
PORT=3000

# Mock BSE API configuration
# In integrated mode, BSE_API_URL defaults to http://localhost:3000/getTrades
# In standalone mock mode, set to http://localhost:4001/getTrades
BSE_API_URL="http://localhost:3000/getTrades"
BSE_DELAY_MS=10000

# Standalone mock BSE server port (optional if run separately)
MOCK_BSE_PORT=4001

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
